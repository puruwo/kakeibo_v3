    { "id": "db.income",        "title": "income",             "subtitle": "収入 (月次収入・ボーナス)",      "group": "db", "x": 1230, "y": 120, "w": 220, "h": 56 },
    { "id": "db.fixedCost",     "title": "fixed_cost",         "subtitle": "固定費定義 (定期支払マスタ)",    "group": "db", "x": 1230, "y": 210, "w": 220, "h": 56 },
    { "id": "db.fixedCostExp",  "title": "fixed_cost_expense", "subtitle": "固定費支出実績 (v6 新規)",        "group": "db", "x": 1230, "y": 300, "w": 220, "h": 56 },
    { "id": "db.budget",        "title": "budget",             "subtitle": "月次予算 (month + bigCategory)", "group": "db", "x": 1230, "y": 390, "w": 220, "h": 56 },
    { "id": "db.category",      "title": "*_category",         "subtitle": "expense/income/fixed_cost Big&Small 5 表", "group": "db", "x": 1230, "y": 480, "w": 220, "h": 56 },
